# ===================================================
# UniPano - Dijital Kampüs Panosu Çevresel Ayarları
# ===================================================
# NOT: Bu dosya şablondur. Hassas anahtarları .env dosyası
# oluşturup içerisine yazınız. .env dosyası .gitignore ile korunmaktadır.

# TinyPNG API Anahtarı (https://tinypng.com/developers)
TINYPNG_API_KEY=

# Görsel Optimizasyon Modu (hybrid, tinypng, gd, off)
IMAGE_DRIVER=hybrid

# Afiş Yeniden Boyutlandırma Sınırı (1920, 1600, 1280, 1024, 0 [orijinal])
IMAGE_RESIZE_DIMENSION=1920

# Sıkıştırma Kalitesi (40-100, varsayılan: 85)
IMAGE_QUALITY=85
